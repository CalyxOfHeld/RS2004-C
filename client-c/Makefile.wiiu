#---------------------------------------------------------------------------------
# RS2004-C (revision 225) - Nintendo Wii U build (devkitPPC + wut + SDL2)
#
#   make -f Makefile.wiiu          -> bin/wiiu/rs2004c.wuhb (also .rpx/.elf)
#   make -f Makefile.wiiu clean
#
# Uses the same client sources as the PC Makefile (sources.mk) and the same
# revision-225 loop object flags. Client data (engine/data/pack/client) is
# bundled as /vol/content; platform/sdl2_main.c starts from there.
#---------------------------------------------------------------------------------

DEVKITPRO ?= C:/devkitPro
DEVKITPPC ?= $(DEVKITPRO)/devkitPPC
WUT_ROOT  := $(DEVKITPRO)/wut
PORTLIBS  := $(DEVKITPRO)/portlibs

CC       := $(DEVKITPPC)/bin/powerpc-eabi-gcc
ELF2RPL  := $(DEVKITPRO)/tools/bin/elf2rpl
WUHBTOOL := $(DEVKITPRO)/tools/bin/wuhbtool

include sources.mk

BUILD_DIR := build_wiiu
OUT_DIR   := bin/wiiu
TARGET    := $(OUT_DIR)/rs2004c
CONTENT   := $(BUILD_DIR)/content
DATA_SRC  := ../engine/data/pack/client

OBJS := $(ALL_SRCS:%.c=$(BUILD_DIR)/%.o) \
        $(BUILD_DIR)/src/client/client225.o \
        $(BUILD_DIR)/src/client/client_log.o \
        $(BUILD_DIR)/platform/sdl2_main.o

MACHDEP := -DESPRESSO -mcpu=750 -meabi -mhard-float
CFLAGS  := -std=c99 -Wall -Wextra -O2 -ffunction-sections $(MACHDEP) \
           -D__WIIU__ -D__WUT__ -Iinclude \
           -I$(PORTLIBS)/wiiu/include -I$(PORTLIBS)/wiiu/include/SDL2 \
           -I$(PORTLIBS)/ppc/include -I$(WUT_ROOT)/include
LDFLAGS := $(MACHDEP) -specs=$(WUT_ROOT)/share/wut.specs -Wl,--gc-sections \
           -L$(PORTLIBS)/wiiu/lib -L$(PORTLIBS)/ppc/lib -L$(WUT_ROOT)/lib
LIBS    := -lSDL2 -lm -lwut

APP_NAME   := RS2004-C
APP_SHORT  := RS2004-C
APP_AUTHOR := RS2004-C

.PHONY: all clean content

all: $(TARGET).wuhb

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Same flags as the PC normal build's revision-225 client loop.
$(BUILD_DIR)/src/client/client225.o: src/client/client.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Werror -DRS2_SCENE225_RUNTIME=1 -DRS2_PIX3D_REV225_TEXTURE=1 -MMD -MP -c $< -o $@

$(TARGET).elf: $(OBJS)
	@mkdir -p $(OUT_DIR)
	$(CC) $(LDFLAGS) $(OBJS) $(LIBS) -o $@

$(TARGET).rpx: $(TARGET).elf
	$(ELF2RPL) $< $@

# Only the client pack directories (no server data) go into /vol/content.
content:
	@rm -rf $(CONTENT)
	@mkdir -p $(CONTENT)/engine/data/pack
	cp -r $(DATA_SRC) $(CONTENT)/engine/data/pack/client

$(TARGET).wuhb: $(TARGET).rpx content
	$(WUHBTOOL) $< $@ --content=$(CONTENT) --name "$(APP_NAME)" --short-name "$(APP_SHORT)" --author "$(APP_AUTHOR)"
	@echo Built $@

clean:
	rm -rf $(BUILD_DIR) $(OUT_DIR)

-include $(OBJS:.o=.d)
